<Window x:Class="Kancelyariya.Views.FunStatsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏆 Офисный детектив и статистика" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🕵️‍♂️ Офисный детектив склада" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Секретные наблюдения за миграцией канцелярии и уровнем офисного дзена" 
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Карточки статистики -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Главный потребитель -->
                <DockPanel Margin="0,4">
                    <TextBlock Text="🥇 Чемпион по потреблению:" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtTopConsumer" Text="—" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" FontWeight="Bold"/>
                </DockPanel>

                <Separator Background="{DynamicResource SubtleBorderBrush}" Margin="0,8"/>

                <!-- Самый бережливый отдел -->
                <DockPanel Margin="0,4">
                    <TextBlock Text="🎖️ Самый бережливый отдел:" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtThriftyDept" Text="—" HorizontalAlignment="Right" 
                               Foreground="#60A5FA" FontWeight="Bold"/>
                </DockPanel>

                <Separator Background="{DynamicResource SubtleBorderBrush}" Margin="0,8"/>

                <!-- Самый популярный товар -->
                <DockPanel Margin="0,4">
                    <TextBlock Text="📦 Самый ходовой предмет:" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtPopularProduct" Text="—" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                </DockPanel>

                <Separator Background="{DynamicResource SubtleBorderBrush}" Margin="0,8"/>

                <!-- Ваше звание -->
                <DockPanel Margin="0,4">
                    <TextBlock Text="🎖️ Ваш официальный статус:" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="TxtUserRank" Text="Специалист по учету" HorizontalAlignment="Right" 
                               Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" FontWeight="Bold"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Зона генератора объяснительной -->
        <Border Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}" 
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="📜 Официальная объяснительная за степлер" FontWeight="Bold" DockPanel.Dock="Left"/>
                    <Button Content="🎲 Создать новую" Click="OnGenerateMemoClick" 
                            Background="{DynamicResource ActionButtonBackgroundBrush}" 
                            Foreground="{DynamicResource ActionButtonForegroundBrush}" 
                            BorderBrush="{DynamicResource ActionButtonBorderBrush}"
                            Height="26" Padding="10,0" HorizontalAlignment="Right"/>
                </DockPanel>

                <TextBox x:Name="TxtMemo" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                         Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>

                <Button Content="📋 Скопировать в буфер обмена" Click="OnCopyMemoClick" 
                        Background="{DynamicResource ActionButtonBackgroundBrush}" 
                        Foreground="{DynamicResource ActionButtonForegroundBrush}" 
                        BorderBrush="{DynamicResource ActionButtonBorderBrush}"
                        Margin="0,8,0,0" HorizontalAlignment="Right" Height="28"/>
            </StackPanel>
        </Border>

        <!-- Статус копирования -->
        <TextBlock Grid.Row="3" x:Name="TxtCopiedStatus" Text="Текст скопирован в буфер обмена!" 
                   Foreground="{DynamicResource PrimaryButtonBackgroundBrush}" FontWeight="SemiBold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="4" Content="Понятно, продолжаю следить за складом" IsDefault="True" Click="OnCloseClick"
                Background="{DynamicResource PrimaryButtonBackgroundBrush}" 
                Foreground="{DynamicResource PrimaryButtonForegroundBrush}" 
                BorderBrush="{DynamicResource PrimaryButtonBorderBrush}"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>
