<Window x:Class="Kancelyariya.Views.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операция" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" 
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" x:Name="RowEmployee"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Тип операции -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Операция:"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbType" SelectionChanged="OnTypeChanged"/>

        <!-- Товар -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Товар:"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbProduct" DisplayMemberPath="Name" SelectionChanged="OnProductChanged"/>

        <!-- Остаток на складе -->
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtStock" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>

        <!-- Количество -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Количество:"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtQty" Text="1"/>

        <!-- Сотрудник (для выдачи) -->
        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LblEmployee" Text="Сотрудник:"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbEmployee" DisplayMemberPath="DisplayName"/>

        <!-- Примечание / Причина -->
        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="LblNote" Text="Примечание:"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtNote"/>

        <!-- Ошибка -->
        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TxtError" 
                   Foreground="#E53E3E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4" Visibility="Collapsed"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Провести" IsDefault="True" Click="OnExecuteClick" 
                    Background="{DynamicResource PrimaryButtonBackgroundBrush}" 
                    Foreground="{DynamicResource PrimaryButtonForegroundBrush}" 
                    BorderBrush="{DynamicResource PrimaryButtonBorderBrush}"/>
            <Button Content="Отмена" IsCancel="True" Click="OnCancelClick"
                    Background="{DynamicResource ActionButtonBackgroundBrush}" 
                    Foreground="{DynamicResource ActionButtonForegroundBrush}" 
                    BorderBrush="{DynamicResource ActionButtonBorderBrush}"/>
        </StackPanel>
    </Grid>
</Window>
